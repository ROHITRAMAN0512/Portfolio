# Copy this file to .env.local for local work. .env.local is never committed.
# On Render, set the same names in the dashboard instead (Environment tab).

# The public address of the site, for example https://rohit-portfolio.onrender.com
# Used for the canonical link, the share preview image and the sitemap.
# Leave empty and those are simply left out.
VITE_SITE_URL=

# Your Web3Forms access key (free, from web3forms.com). It is public by design.
# Leave empty and the contact form opens the visitor's email app instead.
VITE_WEB3FORMS_KEY=
