# Copy this file to .env.local for local work. .env.local is never committed.
# In Cloudflare Pages (or Render), set the same names in the dashboard instead.
# Never paste real values into chat, an issue, or a commit.

# OPTIONAL. The site address already lives in src/content/site.ts (url).
# Set this only to override it without a code change, for example a custom domain.
VITE_SITE_URL=

# Your Web3Forms access key (free, from web3forms.com). It ships to the browser by
# design, but keep it out of the repo anyway.
# Leave empty and the contact form opens the visitor's email app instead.
VITE_WEB3FORMS_KEY=
